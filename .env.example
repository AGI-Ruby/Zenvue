# Public client configuration. Never put a Supabase service-role key here.
# Optional accounts remain disabled until Zenvue's own backend and callbacks are deployed.
VITE_ZENVUE_ACCOUNTS_ENABLED=0
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Leave blank until the hosted recording service is deployed and verified.
# Development defaults to localhost:8787; packaged builds require an explicit URL.
VITE_CLOUD_SHARE_ENDPOINT=
